<resources>
    <style name="Theme.QuizLibre" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/quiz_background</item>
        <item name="android:colorAccent">@color/quiz_neon_cyan</item>
        <item name="android:statusBarColor">@color/quiz_background</item>
        <item name="android:navigationBarColor">@color/quiz_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.QuizLibre.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/quiz_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.QuizLibre</item>
    </style>
</resources>
